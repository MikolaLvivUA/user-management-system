generator client {
  provider = "prisma-client-js"
}

generator class {
  provider = "prisma-class-generator"
  output   = "./generated/classes"
  dryRun   = false
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
